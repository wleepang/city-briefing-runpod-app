# Copy to .env (never commit it) and `set -a; source .env; set +a` or use your platform's secret store.

# Runpod Serverless endpoint (OpenAI-compatible route; llama.cpp queue worker or vLLM)
LLM_BASE_URL=https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
LLM_API_KEY=<runpod api key>
LLM_MODEL=<exact model name the endpoint serves, e.g. Qwen/Qwen2.5-7B-Instruct>

# Local LM Studio instead:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=<model identifier shown in LM Studio>

PORT=8000
# Global cap on LLM calls per 24h across all users (0 = unlimited)
LLM_DAILY_CAP=500
# LLM_MAX_TOKENS=1024
# Longest wait for data from the model (a cold start takes about 1-4 minutes). The streaming route keeps the
# Pod proxy connection alive meanwhile, so this can exceed the proxy's ~100s limit.
# LLM_TIMEOUT_MS=240000
